# --- Supabase (database + accounts). Supabase dashboard > Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# --- Claude (Health Genie, food photos, lab PDFs). console.anthropic.com > API keys ---
ANTHROPIC_API_KEY=
HT_CLAUDE_MODEL=claude-sonnet-5-5   # optional override

# --- Wearables (leave empty to use simulated data) ---
OPEN_WEARABLES_URL=                 # e.g. https://wearables.yourdomain.com (your self-hosted server)
OPEN_WEARABLES_API_KEY=
JUNCTION_API_KEY=                   # sandbox key from the Junction dashboard
JUNCTION_ENV=sandbox                # sandbox | production
JUNCTION_REGION=us                  # us | eu
